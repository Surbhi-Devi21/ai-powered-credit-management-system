# ==============================================================================
# Credit Management System - Backend Environment Configuration Template
# Copy this file to '.env' and fill in your actual credentials.
# ==============================================================================

# Server Runtime Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection URI
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/credit_management_db?retryWrites=true&w=majority

# Redis In-Memory Cache Configuration (Optional - Falls back to direct DB if offline)
REDIS_URL=redis://127.0.0.1:6379
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# JSON Web Token (JWT) Security Settings
JWT_SECRET=your_super_secret_jwt_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=7d

# Client Application URL (For CORS Security)
CLIENT_URL=http://localhost:5173

# OpenRouter AI API Key (For Business Insights Engine)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3-8b-instruct:free
